# Luminal Cloud (OpenAI-compatible chat completions). Keep this file's copy (.env) out of git.
LUMINAL_API_KEY=lum_live_xxx
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Optional
LUMINAL_TIMEOUT_MS=300000
LUMINAL_MAX_TOKENS=32000
LUMINAL_MAX_CONCURRENCY=3
PORT=8787
# Set to "mock" to force the clearly-labelled development provider (no network calls).
AGENT_PROVIDER=luminal
